<!-- =========================================================
     PARTIAL: header
     Injected by layout.hbs. Styles live in layout.hbs <style>.
     ========================================================= -->
<div class='email-header'>
  <div
    class='email-header__logo'
    style='min-height: 36px; height: 36px; line-height: 36px;'
  >
    <a
      href='{{appUrl}}'
      target='_blank'
      rel='noopener noreferrer'
      style='text-decoration: none; display: inline-block; vertical-align: middle;'
    >
      <img
        src='{{logoUrl}}'
        alt='BreathAway'
        class='email-header__logo-img'
        width='250'
        height='36'
        style='display: block; width: 250px; height: 36px; max-width: 250px; max-height: 36px; border: 0; outline: none; margin: 0 auto; color: #FFFFFF; font-family: "Segoe UI", Helvetica, Arial, sans-serif; font-size: 22px; font-weight: 700; letter-spacing: -0.5px; text-align: center;'
      />
    </a>
  </div>
  <p class='email-header__tagline'>Breathe. Connect. Belong.</p>
</div>