<div class='email-footer'>
  <div class='email-footer__links'>
    <a href='{{appUrl}}/privacy'>Privacy Policy</a>
    <a href='{{appUrl}}/terms'>Terms of Service</a>
    <a href='{{appUrl}}/unsubscribe?token={{unsubscribeToken}}'>Unsubscribe</a>
    <a href='{{appUrl}}/help'>Help Centre</a>
  </div>

  <div class='email-footer__social'>
    <a href='https://instagram.com/breathaway'>Instagram</a>
    <a href='https://twitter.com/breathaway'>Twitter</a>
    <a href='https://facebook.com/breathaway'>Facebook</a>
  </div>

  <p class='email-footer__copy'>
    &copy;
    {{currentYear}}
    BreathAway. All rights reserved.<br />
    You are receiving this email because you have an account with BreathAway.<br
    />
    <a href='{{appUrl}}/unsubscribe?token={{unsubscribeToken}}'>Click here to
      unsubscribe</a>
    from marketing emails.
  </p>
</div>