{{!
  Template: device-added
  Data keys:
    - name           {string} Recipient's first name
    - platform       {string} Device platform (e.g. IOS, ANDROID, WEB)
    - deviceId       {string} Unique device identifier or model
    - appVersion     {string} Application version
    - addedAt        {string} Timestamp when device was registered
    - appUrl         {string} Base URL of the app
    - unsubscribeToken {string}
    - currentYear    {number}
}}
<p class='email-greeting'>Security Alert: New Device Added 📱</p>

<p>
  Hello{{#if name}} {{name}}{{/if}},
</p>

<p>
  A new device was recently registered to your BreathAway account for push notifications:
</p>

<div style='background-color: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 12px; padding: 20px 24px; margin: 24px 0;'>
  <table style='width: 100%; border-collapse: collapse;'>
    <tr>
      <td style='padding: 6px 0; color: #6B7280; font-size: 14px;'>Platform:</td>
      <td style='padding: 6px 0; text-align: right; font-weight: 600; color: #1A1A2E; font-size: 14px;'>{{platform}}</td>
    </tr>
    {{#if deviceId}}
    <tr>
      <td style='padding: 6px 0; color: #6B7280; font-size: 14px;'>Device ID:</td>
      <td style='padding: 6px 0; text-align: right; font-family: monospace; font-size: 13px; color: #1A1A2E;'>{{deviceId}}</td>
    </tr>
    {{/if}}
    {{#if appVersion}}
    <tr>
      <td style='padding: 6px 0; color: #6B7280; font-size: 14px;'>App Version:</td>
      <td style='padding: 6px 0; text-align: right; color: #6B7280; font-size: 14px;'>{{appVersion}}</td>
    </tr>
    {{/if}}
    {{#if addedAt}}
    <tr>
      <td style='padding: 6px 0; color: #6B7280; font-size: 14px;'>Registered At:</td>
      <td style='padding: 6px 0; text-align: right; color: #6B7280; font-size: 13px;'>{{addedAt}}</td>
    </tr>
    {{/if}}
  </table>
</div>

<p>
  <strong>Was this you?</strong><br />
  If you recently signed in or reinstalled BreathAway on this device, no further action is necessary.
</p>

<div class='email-alert email-alert--danger'>
  <strong>Don't recognize this device?</strong><br />
  If you didn't add this device, your account security may be compromised. We recommend reviewing your active devices and updating your login credentials right away.
</div>

<div style='text-align: center; margin: 32px 0;'>
  <a href='{{appUrl}}/settings/devices' class='email-btn'>Manage Devices →</a>
</div>

<hr class='email-divider' />

<p style='font-size: 13px; color: #9CA3AF; text-align: center;'>
  BreathAway Security Team
</p>
