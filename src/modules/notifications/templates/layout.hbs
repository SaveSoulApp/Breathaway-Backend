<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>BreathAway</title>
    <!--[if mso]>
    <noscript>
      <xml>
        <o:OfficeDocumentSettings>
          <o:PixelsPerInch>96</o:PixelsPerInch>
        </o:OfficeDocumentSettings>
      </xml>
    </noscript>
    <![endif]-->
    <style>
      /* ==========================================================================
         EMAIL THEME — edit this file to restyle every email in one place
         ========================================================================== */

      /* Reset */
      *, *::before, *::after { box-sizing: border-box; }
      body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
      table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
      img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }
      table { border-collapse: collapse !important; }
      body { margin: 0 !important; padding: 0 !important; width: 100% !important; }

      /* ==========================================================================
         Colour Palette
         ========================================================================== */
      :root {
        --color-brand-primary:   #6C63FF;
        --color-brand-secondary: #4ECDC4;
        --color-brand-accent:    #FF6B6B;
        --color-bg-page:         #F0F2F5;
        --color-bg-card:         #FFFFFF;
        --color-bg-header:       #6C63FF;
        --color-bg-footer:       #2D2D3A;
        --color-text-primary:    #1A1A2E;
        --color-text-secondary:  #6B7280;
        --color-text-on-dark:    #FFFFFF;
        --color-text-muted:      #9CA3AF;
        --color-border:          #E5E7EB;
        --color-cta-bg:          #6C63FF;
        --color-cta-text:        #FFFFFF;
        --color-cta-hover:       #5753D0;
        --color-success:         #10B981;
        --color-warning:         #F59E0B;
        --color-danger:          #EF4444;
        --color-info:            #3B82F6;
      }

      /* ==========================================================================
         Typography
         ========================================================================== */
      body {
        font-family: 'Segoe UI', 'Helvetica Neue', Arial, 'Noto Sans', sans-serif;
        background-color: #F0F2F5;
        color: #1A1A2E;
        font-size: 16px;
        line-height: 1.6;
      }

      h1, h2, h3, h4, h5, h6 {
        margin: 0 0 16px 0;
        font-weight: 700;
        line-height: 1.3;
        color: #1A1A2E;
      }
      h1 { font-size: 28px; }
      h2 { font-size: 22px; }
      h3 { font-size: 18px; }

      p {
        margin: 0 0 16px 0;
        font-size: 16px;
        line-height: 1.7;
        color: #4B5563;
      }
      p:last-child { margin-bottom: 0; }

      a {
        color: #6C63FF;
        text-decoration: none;
      }
      a:hover { text-decoration: underline; }

      /* ==========================================================================
         Layout wrappers
         ========================================================================== */
      .email-wrapper {
        width: 100%;
        background-color: #F0F2F5;
        padding: 40px 20px;
      }

      .email-container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #FFFFFF;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
      }

      /* ==========================================================================
         Header (rendered via {{> header}} partial)
         ========================================================================== */
      .email-header {
        background: linear-gradient(135deg, #6C63FF 0%, #4ECDC4 100%);
        padding: 36px 40px;
        text-align: center;
      }

      .email-header__logo {
        display: inline-block;
        margin-bottom: 8px;
      }

      .email-header__logo-text {
        font-size: 28px;
        font-weight: 800;
        color: #FFFFFF;
        letter-spacing: -0.5px;
      }

      .email-header__logo-icon {
        font-size: 32px;
        margin-right: 6px;
        vertical-align: middle;
      }

      .email-header__tagline {
        font-size: 13px;
        color: rgba(255, 255, 255, 0.8);
        letter-spacing: 1.5px;
        text-transform: uppercase;
        font-weight: 500;
        margin: 4px 0 0 0;
      }

      /* ==========================================================================
         Content area
         ========================================================================== */
      .email-body {
        padding: 48px 40px;
      }

      /* Greeting line */
      .email-greeting {
        font-size: 22px;
        font-weight: 700;
        color: #1A1A2E;
        margin-bottom: 20px;
      }

      /* ==========================================================================
         CTA Button
         ========================================================================== */
      .email-btn {
        display: inline-block;
        background-color: #6C63FF;
        color: #FFFFFF !important;
        font-size: 16px;
        font-weight: 600;
        text-decoration: none !important;
        padding: 14px 32px;
        border-radius: 50px;
        margin: 24px 0;
        letter-spacing: 0.3px;
        /* Outlook fallback */
        mso-padding-alt: 14px 32px;
      }

      /* ==========================================================================
         Info / Highlight box
         ========================================================================== */
      .email-highlight-box {
        background: linear-gradient(135deg, rgba(108, 99, 255, 0.06) 0%, rgba(78, 205, 196, 0.06) 100%);
        border-left: 4px solid #6C63FF;
        border-radius: 0 12px 12px 0;
        padding: 20px 24px;
        margin: 24px 0;
      }

      .email-highlight-box p {
        margin: 0;
        color: #374151;
        font-size: 15px;
      }

      /* Alert variants */
      .email-alert {
        border-radius: 12px;
        padding: 20px 24px;
        margin: 24px 0;
        font-size: 15px;
      }
      .email-alert--info    { background-color: #EFF6FF; border: 1px solid #BFDBFE; color: #1E40AF; }
      .email-alert--success { background-color: #ECFDF5; border: 1px solid #A7F3D0; color: #065F46; }
      .email-alert--warning { background-color: #FFFBEB; border: 1px solid #FDE68A; color: #92400E; }
      .email-alert--danger  { background-color: #FEF2F2; border: 1px solid #FECACA; color: #991B1B; }

      /* ==========================================================================
         Divider
         ========================================================================== */
      .email-divider {
        border: none;
        border-top: 1px solid #E5E7EB;
        margin: 32px 0;
      }

      /* ==========================================================================
         Stat / Badge card
         ========================================================================== */
      .email-stat-card {
        background: linear-gradient(135deg, #6C63FF 0%, #4ECDC4 100%);
        border-radius: 12px;
        padding: 24px;
        text-align: center;
        margin: 24px 0;
        color: #FFFFFF;
      }

      .email-stat-card__value {
        font-size: 40px;
        font-weight: 800;
        margin: 0;
        line-height: 1;
      }

      .email-stat-card__label {
        font-size: 13px;
        color: rgba(255, 255, 255, 0.85);
        letter-spacing: 1px;
        text-transform: uppercase;
        margin: 8px 0 0 0;
      }

      /* ==========================================================================
         Footer (rendered via {{> footer}} partial)
         ========================================================================== */
      .email-footer {
        background-color: #2D2D3A;
        padding: 36px 40px;
        text-align: center;
      }

      .email-footer__links {
        margin-bottom: 20px;
      }

      .email-footer__links a {
        color: rgba(255, 255, 255, 0.7);
        font-size: 13px;
        margin: 0 10px;
        text-decoration: none;
      }

      .email-footer__links a:hover {
        color: #FFFFFF;
        text-decoration: underline;
      }

      .email-footer__social {
        margin-bottom: 20px;
      }

      .email-footer__social a {
        display: inline-block;
        margin: 0 6px;
        color: rgba(255, 255, 255, 0.7);
        font-size: 13px;
        text-decoration: none;
      }

      .email-footer__copy {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.45);
        line-height: 1.7;
      }

      .email-footer__copy a {
        color: rgba(255, 255, 255, 0.6);
        text-decoration: underline;
      }

      /* ==========================================================================
         Responsive
         ========================================================================== */
      @media only screen and (max-width: 600px) {
        .email-wrapper  { padding: 20px 12px !important; }
        .email-body     { padding: 32px 24px !important; }
        .email-header   { padding: 28px 24px !important; }
        .email-footer   { padding: 28px 24px !important; }
        h1              { font-size: 22px !important; }
        .email-btn      { display: block !important; text-align: center !important; }
      }
    </style>
  </head>
  <body>
    <div class="email-wrapper">
      <div class="email-container">
        {{> header}}
        <div class="email-body">
          {{{body}}}
        </div>
        {{> footer}}
      </div>
    </div>
  </body>
</html>
