generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum IdentityType {
  PHONE
  EMAIL
  INSTAGRAM
  LINKEDIN
  TWITTER
  OTHER
}

enum AuthCredentialType {
  PHONE
  EMAIL
}

enum IntentType {
  RELATIONSHIP
  CASUAL
  OPEN
}

enum LikeStatus {
  PENDING
  MATCHED
  VOIDED
  DELETED
}

enum MatchStatus {
  ACTIVE
  UNMATCHED
  BLOCKED
}

enum CreditTransactionType {
  CREDIT
  DEBIT
}

enum CreditSource {
  PURCHASE
  BONUS
  REFERRAL
  LIKE_USAGE
  ADMIN
  EXPIRED
  SUBSCRIPTION
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum GenderType {
  MALE
  FEMALE
  NONBINARY
  OTHER
}

model User {
  id               String           @id @default(ulid())

  profile                UserProfile?
  notificationPreference NotificationPreference?

  identities       Identity[]
  authCredentials  AuthCredential[]

  sentLikes        Like[]           @relation("SentLikes")
  receivedLikes    Like[]           @relation("ReceivedLikes")

  matchesAsUserOne Match[]          @relation("MatchUserOne")
  matchesAsUserTwo Match[]          @relation("MatchUserTwo")

  blocking         Block[]          @relation("Blocker")
  blockedBy        Block[]          @relation("Blocked")

  devices          Device[]
  creditLedger     CreditLedger[]
  subscriptions    UserSubscription[]

  createdAt        DateTime         @default(now())
  deletedAt        DateTime?

  @@index([createdAt])
}

model UserProfile {
  id           String     @id @default(ulid())

  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName    String
  lastName     String?

  dateOfBirth  DateTime?
  gender       GenderType?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model AuthCredential {
  id          String             @id @default(ulid())

  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        AuthCredentialType

  valueHash   String             @unique @db.Char(64)
  valueMasked String?

  isPrimary   Boolean            @default(false)

  identityId  String             @unique
  identity    Identity           @relation(fields: [identityId], references: [id], onDelete: Cascade)

  createdAt   DateTime           @default(now())
  deletedAt   DateTime?

  @@unique([userId, type])
  @@index([userId])
}

model Identity {
  id                    String          @id @default(ulid())

  type                  IdentityType

  publicValueHash       String          @db.Char(64)
  publicValueCiphertext String
  publicValueIv         String          @db.Char(24)
  publicValueTag        String          @db.Char(24)
  publicValueWrappedKey String
  publicValueKeyId      String
  publicValueMasked     String?

  platformIdHash        String?         @db.Char(64)
  platformIdCiphertext  String?
  platformIdIv          String?         @db.Char(24)
  platformIdTag         String?         @db.Char(24)
  platformIdWrappedKey  String?
  platformIdKeyId       String?

  userId                String?
  user                  User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  isVerified            Boolean         @default(false)
  verifiedAt            DateTime?

  authCredential        AuthCredential?

  likes                 Like[]

  createdAt             DateTime        @default(now())
  deletedAt             DateTime?

  @@unique([type, publicValueHash])
  @@unique([type, platformIdHash])
  @@index([userId])
  @@index([platformIdHash])
}

model Like {
  id               String      @id @default(ulid())

  senderUserId     String
  senderUser       User        @relation("SentLikes", fields: [senderUserId], references: [id], onDelete: Cascade)

  targetIdentityId String
  targetIdentity   Identity    @relation(fields: [targetIdentityId], references: [id], onDelete: Cascade)

  targetUserId     String?
  targetUser       User?       @relation("ReceivedLikes", fields: [targetUserId], references: [id])

  intent           IntentType
  status           LikeStatus  @default(PENDING)

  matchAsLikeOne   Match?      @relation("MatchLikeOne")
  matchAsLikeTwo   Match?      @relation("MatchLikeTwo")

  createdAt        DateTime    @default(now())
  expiresAt        DateTime?
  deletedAt        DateTime?

  @@unique([senderUserId, targetIdentityId])
  @@index([senderUserId])
  @@index([targetIdentityId])
  @@index([targetUserId])
  @@index([status])
  @@index([expiresAt])
}

model Match {
  id        String      @id @default(ulid())

  userOneId String
  userOne   User        @relation("MatchUserOne", fields: [userOneId], references: [id], onDelete: Cascade)

  userTwoId String
  userTwo   User        @relation("MatchUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)

  likeOneId String      @unique
  likeOne   Like        @relation("MatchLikeOne", fields: [likeOneId], references: [id])

  likeTwoId String      @unique
  likeTwo   Like        @relation("MatchLikeTwo", fields: [likeTwoId], references: [id])

  intentOne IntentType
  intentTwo IntentType

  status    MatchStatus @default(ACTIVE)

  matchedAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  @@unique([userOneId, userTwoId])
  @@index([userOneId])
  @@index([userTwoId])
}

model Block {
  id            String   @id @default(ulid())

  blockerUserId String
  blocker       User     @relation("Blocker", fields: [blockerUserId], references: [id], onDelete: Cascade)

  blockedUserId String
  blocked       User     @relation("Blocked", fields: [blockedUserId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  deletedAt     DateTime?

  @@unique([blockerUserId, blockedUserId])
}

model Device {
  id         String         @id @default(ulid())

  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  token      String         @unique
  platform   DevicePlatform
  deviceId   String?
  appVersion String?

  isActive   Boolean        @default(true)

  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([userId])
}

model CreditLedger {
  id          String       @id @default(ulid())

  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactionType CreditTransactionType

  amount          Int
  source          CreditSource
  referenceId String?

  expiresAt   DateTime?

  createdAt   DateTime     @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model NotificationPreference {
  id              String   @id @default(ulid())

  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  pushEnabled     Boolean  @default(true)
  whatsappEnabled Boolean  @default(true)
  smsEnabled      Boolean  @default(true)
  emailEnabled    Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ──────────────────────────────────────────────
// Subscription Management
// ──────────────────────────────────────────────

enum SubscriptionPlanStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  GRACE_PERIOD
  REVOKED
  PAUSED
}

enum StorePlatform {
  APPLE
  GOOGLE
}

enum CurrencyCode {
  INR
  USD
  SGD
  AED
  GBP
  EUR
  AUD
}

enum SubscriptionEventType {
  INITIAL_PURCHASE
  RENEWAL
  CANCELLATION
  GRACE_PERIOD_ENTERED
  BILLING_RECOVERY
  REVOCATION
  REFUND
  PRICE_CHANGE_CONFIRMED
  EXPIRY
}

model SubscriptionPlan {
  id                String                 @id @default(ulid())

  name              String
  description       String?
  slug              String                 @unique

  appleProductId    String?                @unique
  googleProductId   String?                @unique

  creditsGranted    Int
  validityDays      Int
  trialDurationDays Int                    @default(0)

  sortOrder         Int                    @default(0)
  status            SubscriptionPlanStatus @default(ACTIVE)

  prices            SubscriptionPlanPrice[]
  subscriptions     UserSubscription[]

  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([status])
}

model SubscriptionPlanPrice {
  id             String           @id @default(ulid())

  planId         String
  plan           SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  currencyCode   CurrencyCode
  price          Decimal          @db.Decimal(10, 2)
  countryCode    String           @db.Char(2)

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([planId, currencyCode, countryCode])
  @@index([countryCode])
}

model UserSubscription {
  id                    String             @id @default(ulid())

  userId                String
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId                String
  plan                  SubscriptionPlan   @relation(fields: [planId], references: [id])

  status                SubscriptionStatus @default(ACTIVE)
  storePlatform         StorePlatform

  storeTransactionId    String?
  storeProductId        String?

  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  trialEnd              DateTime?

  autoRenewing          Boolean            @default(false)
  cancelledAt           DateTime?
  expiresAt             DateTime

  currencyCode          CurrencyCode?
  pricePaid             Decimal?           @db.Decimal(10, 2)
  countryCode           String?            @db.Char(2)

  events                SubscriptionEvent[]

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([userId])
  @@index([status])
  @@index([storeTransactionId])
  @@index([expiresAt])
}

model SubscriptionEvent {
  id               String                @id @default(ulid())

  subscriptionId   String
  subscription     UserSubscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  eventType        SubscriptionEventType
  storePlatform    StorePlatform

  storeEventId     String?
  rawPayload       Json?

  createdAt        DateTime              @default(now())

  @@index([subscriptionId])
  @@index([eventType])
  @@index([storeEventId])
}