generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  user_id        Int      @id @default(autoincrement())
  uid            String?  @unique
  email          String?  @unique
  email_verified Boolean  @default(false)
  phone          String?  @unique
  phone_verified Boolean  @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
